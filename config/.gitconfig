# =============================================================================
#                           GIT CONFIG - herwingx
# =============================================================================
# 💡 GUÍA DE PERSONALIZACIÓN:
# Este archivo define el comportamiento global de Git.
# - [alias]: Atajos para comandos comunes (ej: 'git c' en lugar de 'git commit')
# - [user]: Tus datos de identidad
# - [core] / [delta]: Visualización de diffs con syntax highlighting
# =============================================================================

[user]
    name = Eduardo Macias
    email = developer@herwingx.com

[init]
    defaultBranch = main

[core]
    editor = code --wait
    autocrlf = input
    pager = less -F -X

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    light = false
    line-numbers = true
    syntax-theme = Dracula

# -----------------------------------------------------------------------------
# PULL - Siempre usar rebase (historial limpio)
# -----------------------------------------------------------------------------
[pull]
    rebase = true

# -----------------------------------------------------------------------------
# REBASE - Configuración óptima
# -----------------------------------------------------------------------------
[rebase]
    autoStash = true
    autoSquash = true

# -----------------------------------------------------------------------------
# MERGE - Solo fast-forward (evita commits de merge innecesarios)
# -----------------------------------------------------------------------------
[merge]
    ff = only
    conflictstyle = zdiff3

# -----------------------------------------------------------------------------
# PUSH - Configuración segura
# -----------------------------------------------------------------------------
[push]
    default = current
    autoSetupRemote = true

# -----------------------------------------------------------------------------
# FETCH - Limpiar ramas eliminadas en remote
# -----------------------------------------------------------------------------
[fetch]
    prune = true

# -----------------------------------------------------------------------------
# DIFF - Mejor visualización
# -----------------------------------------------------------------------------
[diff]
    renames = copies
    algorithm = histogram
    colorMoved = default

[color]
    ui = auto

# -----------------------------------------------------------------------------
# ALIASES - Productividad
# -----------------------------------------------------------------------------
[alias]
    # Log bonito
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) > %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(yellow)%d%C(reset)'
    lg10 = lg -10

    # Editar último commit
    amend = commit --amend --no-edit
    edit = commit --amend

    # Clonar superficial (más rápido)
    clone-shallow = clone --depth 1

    # Status corto
    s = status -sb

    # Branches
    br = branch -v
    bra = branch -va

    # Checkout / Switch
    co = checkout
    cob = checkout -b
    sw = switch
    rs = restore

    # Diff
    d = diff
    dc = diff --cached
    ds = diff --staged

    # Pull con rebase
    pr = pull --rebase
    l = pull --rebase

    # Push
    p = push
    pf = push --force-with-lease

    # Deshacer último commit (mantiene cambios)
    undo = reset --soft HEAD~1

    # Limpiar ramas mergeadas
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master' | xargs -r -n 1 git branch -d"

    # Sync con main usando rebase
    sync = "!git fetch origin && git rebase origin/main"

    # Add & Commit shortcuts
    a = add
    aa = add .
    c = commit -m
    ca = commit -am
    b = branch -v
    glog = log --oneline --graph --decorate -10
    last = show --stat

    # Stash rápido
    ss = stash push
    sp = stash pop
    sl = stash list