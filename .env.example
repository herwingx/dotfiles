# =============================================================================
# 🔐 PLANTILLA DE REFERENCIAS DE SECRETOS EN PROTON PASS (.env.example)
# =============================================================================
# Este archivo NO contiene contraseñas ni tokens en texto plano; únicamente
# guarda las rutas de referencia (`pass://<Bóveda>/<Ítem>/<Campo>`) de Proton Pass.
#
# ¿Cómo funciona?
#   1. Inicia sesión en Proton Pass CLI:
#        pass-cli login
#   2. Sincroniza o sube tus secretos con el gestor interactivo:
#        ./scripts/manage_secrets.sh
#   3. Ejecuta cualquier comando inyectando tus secretos en memoria al vuelo:
#        pass-cli run --env-file .env.example -- <comando>
# =============================================================================

# Ubicación en Proton Pass (Bóveda: Personal, Nota/Ítem: dotfiles)
PROTON_PASS_VAULT="Personal"
PROTON_PASS_ITEM="dotfiles"

# 🐙 Token Personal de GitHub (Permisos: repo, read:user, workflow)
# Usado para autenticar 'gh' CLI y evitar límites de descargas en 'mise'
GH_TOKEN="pass://Personal/dotfiles/GH_TOKEN"

# ☁️ Token JSON de Rclone para Google Drive (JSON completo en una sola línea)
# Usado por scripts/cloud.sh para generar ~/.config/rclone/rclone.conf
RCLONE_TOKEN_JSON="pass://Personal/dotfiles/RCLONE_TOKEN_JSON"

# 📢 Configuración de Bot de Telegram (Para avisos de actualizaciones del servidor)
# Usado por scripts/cron-update.sh -> ~/.config/dotfiles/telegram.env
TELEGRAM_BOT_TOKEN="pass://Personal/dotfiles/TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="pass://Personal/dotfiles/TELEGRAM_CHAT_ID"
